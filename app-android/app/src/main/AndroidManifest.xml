<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Para distinguir, sin cuenta, una pagina que no carga de no tener red (ANADIR.md). Es un
         permiso normal: no se pregunta al instalar. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".Guardalo"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/reglas_copia"
        android:fullBackupContent="@xml/reglas_copia_antigua"
        android:icon="@mipmap/icono"
        android:label="Guárdalo"
        android:localeConfig="@xml/idiomas"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        tools:targetApi="33">

        <!-- singleTask para que la vuelta del inicio de sesion por enlace llegue a esta misma
             actividad (onNewIntent) y no abra otra encima, sin el inicio de sesion en curso. -->
        <activity
            android:name=".ActividadPrincipal"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Solo para cuando el navegador no tiene Auth Tab: con ella, la vuelta no pasa por
                 aqui. Ver IniciadorDeSesion. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="guardarenlaces" android:host="auth-callback" />
            </intent-filter>
        </activity>

        <!-- Compartir desde otra aplicación. Android no deja pedir solo direcciones: sale al
             compartir cualquier texto, y la actividad dice si no lleva ninguna. Tarea propia
             (taskAffinity vacía) y fuera de recientes, para volver a la aplicación de origen al
             terminar y no quedarse encima de Guárdalo si estaba abierto. -->
        <activity
            android:name=".ActividadCompartir"
            android:exported="true"
            android:excludeFromRecents="true"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
