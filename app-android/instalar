#!/bin/bash
# Compila, instala en el teléfono y abre la app. Sin pasar por las pruebas:
# es para oír un cambio con TalkBack cuanto antes. Antes de un commit, siempre
# `./verificar` entero.
set -euo pipefail

cd "$(dirname "$0")"
source herramientas/telefono.sh

./gradlew --quiet :app:installDebug
"$ADB" shell am start -n com.jmortizsilva.guardarenlaces/.ActividadPrincipal >/dev/null 2>&1
echo "Instalada y abierta en $ANDROID_SERIAL."
