{
  "name": "servidor-guardar-enlaces",
  "version": "1.0.0",
  "description": "Backend de 'Guardar enlaces' (sincronizacion iOS/Windows). Node + Fastify + SQLite, proceso y contenedor propios.",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "comprobar-tipos": "tsc --noEmit",
    "lint": "eslint .",
    "formatear": "eslint . --fix",
    "test": "vitest run",
    "verificar": "npm run comprobar-tipos && npm run lint && npm test",
    "crear-invitacion": "tsx src/scripts/crearInvitacion.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.1",
    "better-sqlite3": "^12.2.0",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
